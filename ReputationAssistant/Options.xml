<?xml version="1.0" encoding="utf-8"?>
<options>

  <!-- ===== Main Settings ===== -->
  <option ID="OptionRAEnabled"
          DisplayText="Enable Reputation Assistant"
          Category="Mod: Reputation Assistant"
          Type="Checkbox"
          Default="Yes"
          SearchKeywords="reputation assistant faction tracker">
    <helptext>
      Appends reputation tracking to the look popup for creatures
      that affect faction reputation (legendaries, named characters).
      Default: On
    </helptext>
  </option>

  <option ID="OptionRAShowOutcomes"
          DisplayText="Show Water Ritual / Kill Outcomes"
          Category="Mod: Reputation Assistant"
          Type="Checkbox"
          Default="Yes"
          Requires="OptionRAEnabled==Yes"
          SearchKeywords="reputation assistant water ritual kill outcomes">
    <helptext>
      Show projected reputation after Water Ritual and Kill actions.
      Disable to show only current rep and target.
      Default: On
    </helptext>
  </option>

  <option ID="OptionRACompactLayout"
          DisplayText="Compact Layout (single line)"
          Category="Mod: Reputation Assistant"
          Type="Checkbox"
          Default="No"
          Requires="OptionRAEnabled==Yes"
          SearchKeywords="reputation assistant compact layout single line">
    <helptext>
      Show rep, target, and outcomes on a single line instead of two.
      Default: Off
    </helptext>
  </option>

  <option ID="OptionRAShowFaction"
          DisplayText="Show Creature Factions"
          Category="Mod: Reputation Assistant"
          Type="Checkbox"
          Default="No"
          Requires="OptionRAEnabled==Yes"
          SearchKeywords="reputation assistant faction membership creature show">
    <helptext>
      Display each creature's primary faction in the look popup description. Default: Off
    </helptext>
  </option>

  <!-- ===== Per-Faction Overrides ===== -->
  <option ID="OptionRAFaction"
          DisplayText="Configure Faction"
          Category="Mod: Reputation Assistant"
          Type="Combo"
          Values="(None),Antelopes,Apes,Arachnids,Baboons,Baetyls,Barathrumites,Bears,Birds,Cannibals,Cats,Chavvah,Consortium,Crabs,Cragmensch,Daughters,Dogs,Dromad,Entropic,Equines,Ezra,Farmers,Fish,Flowers,Frogs,Fungi,Girsh,Goatfolk,Gyre Wights,Hermits,Hindren,Insects,Issachari,Joppa,Kyakukya,Mamon,Mechanimists,Merchants,Mollusks,Mopango,Naphtaali,Newly Sentient Beings,Oozes,Pariahs,Prey,Resheph,Robots,Roots,Seekers,Snapjaws,Strangers,Succulents,SultanCult1,SultanCult2,SultanCult3,SultanCult4,SultanCult5,Svardym,Swine,Templar (Mutant),Templar (True Kin),Tortoises,Trees,Trolls,Unshelled Reptiles,Urchins,Vines,Wardens,Water,Winged Mammals,Worms,YdFreehold"
